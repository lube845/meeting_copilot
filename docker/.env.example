# ============================================
# 智能会议助手 · 环境配置示例
# ============================================
# 复制此文件为 .env 后填入实际值
# ============================================

# ------------------
# App Settings
# ------------------
APP_NAME="智能会议助手"
APP_VERSION="1.0.0"
DEBUG=false
TZ=Asia/Shanghai
PYTHONPATH=/workspace

# ==========================================
# 管理员账号（本地登录，OA 未启用时的兼底入口）
# ==========================================
# 这三项是管理员登录信息的唯一来源：
# - 首次启动：自动创建该账号（并强制首次登录改密）
# - 之后每次启动：若库里的密码与这里不一致，会按这里重置
#   （运维改完 .env 重启即生效；界面上改的密码会在下次重启被覆盖）
# 必填，留空则服务拒绝启动
# 生成密码示例：openssl rand -base64 12
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=<your_initial_admin_password>
DEFAULT_ADMIN_NAME=超级管理员

# ------------------
# Database
# ------------------
DB_HOST=mysql
DB_PORT=3306
DB_USER=meeting_copilot_admin
DB_PASSWORD=<your_db_password>
DB_NAME=meeting_copilot_db
MYSQL_ROOT_PASSWORD=<your_mysql_root_password>

# ------------------
# MinIO / OSS
# ------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

OSS_ENDPOINT=http://minio:9000
OSS_ACCESS_KEY=<your_minio_access_key>
OSS_SECRET_KEY=<your_minio_secret_key>
OSS_BUCKET=meeting-copilot-files
OSS_SECURE=false

# ------------------
# LLM
# ------------------
LLM_API_KEY=<your_llm_api_key_or_blank>
LLM_MODEL=Qwen3-32B
LLM_API_ENDPOINT=<your_llm_chat_completions_url>
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=16384
# 单次 LLM 请求超时（秒）。长会议纪要要吐上万 token，60s 必然超时，默认给 15 分钟。
LLM_TIMEOUT=900
# 单次 LLM 请求内部的失败重试次数（外层 task_queue 另有 3 次任务重试）
LLM_MAX_RETRIES=2

# ------------------
# ASR（外部服务地址 - 由 backend 通过 HTTP 调用）
# ------------------
# 填入你自己的 ASR 服务 base URL（不包含 /transcribe_upload 后缀）。
# 后端会自动 POST {ASR_API_URL}/transcribe_upload/，form 字段名 upload_file。
# 该服务只需实现与原 asr_app.py 兼容的接口即可（返回 markdown / segments / speaker_cnt）。
# 也可在前端"系统设置 → ASR 配置"页在线修改并实时生效。
ASR_API_URL=<your_external_asr_service_url>
ASR_API_KEY=<your_asr_api_key_or_blank>

# ------------------
# 是否允许 LLM / ASR 指向内网地址
# ------------------
# true  = 允许回环(127/8、::1)与 RFC1918(10/8、172.16/12、192.168/16)、fc00::/7
#          （ASR/LLM 常与后端同机或同网段，这是本项目常态，默认开启）
# false = 完全禁止所有内网地址（LLM/ASR 在公网时用）
# 无论开关如何：链路本地(169.254/16，含云元数据)、非 http(s) 协议永远拒绝
ALLOW_INTERNAL_SERVICE_URLS=true

# ------------------
# HMAC 签名密钥（用于会话令牌防伪造，必填）
# 用 `openssl rand -hex 32` 生成；更换后所有旧 token 失效
# ------------------
AUTH_SECRET=<openssl_rand_hex_32>

# ------------------
# OA 认证（可选）
# ------------------
# 填入 OA 系统地址后启用 OA 登录：非本地账号一律转发到 OA 校验密码，
# 首次登录自动在本地 users 表建档（只存员工信息，不存密码）。
# 留空则关闭 OA 登录，只有本地账号（DEFAULT_ADMIN_USER）能登录。
# OA 接口：
#   POST {OA_BASE_URL}/api/hrm/login/checkLogin               校验工号+密码
#   POST {OA_BASE_URL}/api/hrm/resful/getHrmUserInfoWithPage  按工号查员工信息
OA_BASE_URL=
OA_API_IDENTIFIER=
OA_TIMEOUT=10

# ------------------
# 会议纪要模板路径
# ------------------
MEETING_TEMPLATES_PATH=/workspace/meeting_summary_templates.json

# ------------------
# Ports
# ------------------
FRONTEND_EXTERNAL_PORT=8888
BACKEND_EXTERNAL_PORT=8000
DB_EXTERNAL_PORT=3307

# ------------------
# CORS
# ------------------
CORS_ORIGINS=http://localhost:8888,http://localhost:3000